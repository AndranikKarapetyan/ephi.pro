# ============================================
# Variables d'environnement pour Netlify
# ============================================
# 
# IMPORTANT: 
# - Copiez ces variables dans le dashboard Netlify
# - Allez dans: Site Settings > Environment Variables
# - Ne commitez JAMAIS ce fichier avec de vraies valeurs !
#
# ============================================

# ============================================
# Configuration Email (SMTP)
# ============================================
# Ces variables sont nécessaires pour l'envoi des emails
# d'inscription et de confirmation

# Serveur SMTP (Gmail, SendGrid, Mailgun, etc.)
SMTP_HOST=smtp.gmail.com

# Port SMTP (587 pour TLS, 465 pour SSL)
SMTP_PORT=587

# Compte email utilisé pour envoyer les emails
# Pour Gmail: créez un "mot de passe d'application" ici:
# https://myaccount.google.com/apppasswords
SMTP_USER=votre-email@gmail.com

# Mot de passe d'application Gmail (PAS votre mot de passe habituel)
# Pour Gmail: utilisez le mot de passe d'application généré
SMTP_PASS=votre-mot-de-passe-application-gmail

# Email qui recevra les notifications d'inscription
NOTIFICATION_EMAIL=info@maxiavenue.com


# ============================================
# Configuration Base de Données (Supabase)
# ============================================
# OBLIGATOIRE: Ces variables sont nécessaires pour sauvegarder
# et afficher les inscriptions dans le dashboard admin
# Consultez SUPABASE_SETUP.md pour créer votre projet

# URL de votre projet Supabase
# Format: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=https://votre-projet.supabase.co

# Clé API publique (anon key)
# IMPORTANT: Utilisez la clé "anon public", PAS "service_role"
# Trouvez-la dans: Supabase Dashboard > Settings > API
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# ============================================
# Configuration Admin (Authentification)
# ============================================
# Credentials pour accéder au dashboard admin
# CHANGEZ CES VALEURS pour plus de sécurité !

# Nom d'utilisateur admin
ADMIN_USERNAME=admin

# Mot de passe admin (utilisez un mot de passe fort)
# Recommandé: 16+ caractères avec lettres, chiffres et symboles
ADMIN_PASSWORD=ephi2026


# ============================================
# Configuration Optionnelle
# ============================================

# URL du site (optionnel, utilisé pour les liens dans les emails)
# SITE_URL=https://ephi.pro

# Nom de l'expéditeur dans les emails (optionnel)
# FROM_NAME=EPHI 2026

# Email de réponse (optionnel)
# REPLY_TO=contact@ephi.pro


# ============================================
# Notes importantes
# ============================================
#
# 1. Configuration Supabase (OBLIGATOIRE):
#    - Créez un compte gratuit sur https://supabase.com
#    - Créez un nouveau projet
#    - Créez la table 'registrations' avec le SQL fourni
#    - Récupérez SUPABASE_URL et SUPABASE_KEY (anon/public)
#    - Consultez SUPABASE_SETUP.md pour les instructions détaillées
#
# 2. SMTP Gmail (optionnel):
#    - Activez la validation en 2 étapes sur votre compte Google
#    - Créez un mot de passe d'application: https://myaccount.google.com/apppasswords
#    - Utilisez ce mot de passe dans SMTP_PASS (pas votre mot de passe Gmail)
#
# 3. Autres providers SMTP (optionnel):
#    - SendGrid: https://sendgrid.com/ (100 emails/jour gratuit)
#    - Mailgun: https://www.mailgun.com/ (5,000 emails/mois gratuit)
#    - Amazon SES: https://aws.amazon.com/ses/
#
# 4. Sécurité:
#    - Ne partagez JAMAIS ces credentials
#    - Utilisez des mots de passe forts
#    - Changez les credentials par défaut
#    - Ne commitez pas le fichier .env dans Git
#
# 5. Déploiement sur Netlify:
#    - Allez dans: Site Settings > Environment Variables
#    - Cliquez sur "Add a variable" pour chaque variable
#    - Collez le nom et la valeur
#    - Cliquez sur "Save"
#    - Redéployez votre site pour appliquer les changements
#
# ============================================
